# Copy to .env before running `docker compose up -d`.
# docker-compose.yml declares no defaults, so every variable below is required.

# --- api-gateway-auth database (host port 5433) ---
AUTH_DB_NAME=auth_db
AUTH_DB_USER=studymind
AUTH_DB_PASSWORD=studymind

# --- content-service database (host port 5434) ---
CONTENT_DB_NAME=content_db
CONTENT_DB_USER=studymind
CONTENT_DB_PASSWORD=studymind

# --- chat-llm-service database (host port 5436) ---
CHAT_DB_NAME=chat_db
CHAT_DB_USER=studymind
CHAT_DB_PASSWORD=studymind

# --- RabbitMQ (5672, management UI on 15672) ---
RABBITMQ_USER=studymind
RABBITMQ_PASS=studymind

# --- MinIO (S3 API on 9000, console on 9001) ---
MINIO_ROOT_USER=studymind
MINIO_ROOT_PASSWORD=studymind
STORAGE_BUCKET=studymind
