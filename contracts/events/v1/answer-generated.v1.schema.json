{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studymind/contracts/events/v1/answer-generated.v1.schema.json",
  "title": "AnswerGeneratedV1",
  "allOf": [
    {
      "$ref": "./event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "AnswerGenerated"
        },
        "source_service": {
          "const": "chat-llm-service"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "message_id",
            "user_id",
            "content_ids",
            "chunk_ids",
            "model"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "message_id": {
              "type": "string",
              "format": "uuid"
            },
            "user_id": {
              "type": "string",
              "format": "uuid"
            },
            "content_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "chunk_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "latency_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  ]
}
