{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studymind/contracts/events/v1/chunks-created.v1.schema.json",
  "title": "ChunksCreatedV1",
  "allOf": [
    {
      "$ref": "./event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "ChunksCreated"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_id",
            "user_id",
            "type",
            "chunk_ids",
            "chunk_count"
          ],
          "properties": {
            "content_id": {
              "type": "string",
              "format": "uuid"
            },
            "user_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "PDF",
                "VIDEO"
              ]
            },
            "chunk_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "chunk_count": {
              "type": "integer",
              "minimum": 1
            },
            "has_timestamps": {
              "type": "boolean"
            }
          }
        }
      }
    }
  ]
}
